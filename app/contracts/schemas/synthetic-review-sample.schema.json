{
  "$defs": {
    "ReviewVerdict": {
      "description": "El veredicto de Miguel sobre la muestra (AC5.4.5, AC5.5.6).",
      "enum": [
        "own_text_structure_ok",
        "changes_requested"
      ],
      "title": "ReviewVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "La muestra de diez clausulas que revisa Miguel (BR5.4).\n\nEl veredicto llega despues de la muestra, y con el su fecha y su commit: un\nveredicto sin fecha ni commit no dice que se reviso, ni cuando.",
  "properties": {
    "tenant_id": {
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "sample_seed": {
      "minimum": 0,
      "title": "Sample Seed",
      "type": "integer"
    },
    "clause_ids": {
      "items": {
        "pattern": "^[A-Z]{2}-[A-Z]{3}-\\d{4}(?:-END-[1-9]\\d*)?-[A-Za-z0-9]+(?:\\.[A-Za-z0-9_]+)*$",
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Clause Ids",
      "type": "array"
    },
    "reviewed_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed On"
    },
    "commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "tenant_id",
    "sample_seed",
    "clause_ids"
  ],
  "title": "ReviewSample",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://untangle.local/contracts/schemas/synthetic-review-sample.schema.json"
}
