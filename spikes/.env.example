# Copia este archivo como spikes/.env y pon tus claves ahí. spikes/.env no se versiona.
# Crea claves solo para estos experimentos y bórralas o rótalas al terminar.
# Nunca pegues una clave en el chat.

# Google AI Studio, en un proyecto sin facturación activada (experimento 2).
# Las claves nuevas empiezan con AQ.: es el formato vigente.
GEMINI_API_KEY=

# Deepgram (experimento 3)
DEEPGRAM_API_KEY=

# Cartesia (experimento 4)
CARTESIA_API_KEY=

# ElevenLabs, opcional (experimento 4). Clave restringida: solo texto a voz y
# lectura de voces, con límite de créditos y vencimiento de 30 días.
ELEVENLABS_API_KEY=
